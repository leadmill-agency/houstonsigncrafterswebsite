# Houston Sign Crafters — environment variables
# Copy to .env.local for local dev, and set the same keys in Vercel for preview/prod.
# .env* is gitignored — never commit real keys.

# --- Resend: automated/transactional email (lead notifications + auto-responders) ---
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender. Until houstonsigncrafters.com is verified in Resend Domains,
# you can use the sandbox sender "onboarding@resend.dev" (lib/leads.js falls back to it).
# After domain verification:
RESEND_FROM_EMAIL="Houston Sign Crafters <noreply@houstonsigncrafters.com>"

# Where lead notifications are delivered (defaults to BUSINESS.email in data/business.js)
RESEND_TO_EMAIL=sales@houstonsigncrafters.com

# --- beehiiv: the weekly newsletter list ---
# Lead emails get subscribed to this beehiiv publication. Find these in
# beehiiv → Settings → API. Until both are set, newsletter signup is skipped.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# --- Analytics / Search Console ---
# GA4 Measurement ID (G-XXXXXXXXXX). Leave blank in dev to disable analytics.
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID — for the /lp ad landing pages. Tracks PageView +
# fires a "Lead" event on form submit so Meta can optimize ad delivery.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console HTML-tag verification token (optional if verifying via DNS)
NEXT_PUBLIC_GSC_VERIFICATION=
